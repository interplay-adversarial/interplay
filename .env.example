# Copy to .env and fill in the values you need: `cp .env.example .env`
# load_env_file() (interplay.red_teaming.base) and python-dotenv (examples/,
# pipeline.py) both read this file automatically; never commit your real .env.
#
# NOT for the description-driven assessment API (`interplay assess`): that
# command takes a separate, private (chmod 0600) JSON config file instead —
# see docs/assessment.md. These variables are for probe generation and the
# legacy attack runners only.

# --- Probe generation (`interplay probes ...` / pipeline.py) ---
# Also configurable once via `interplay probes setup --base-url ... --model ...`.
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=gpt-4o-mini

# --- Target endpoint (attack runners: TAP, PAIR, Crescendo, GOAT, SLIP, Multimodal) ---
TARGET_URL=https://your-target/v1
TARGET_API_KEY=
TARGET_MODEL=your-model-name

# --- Judge model (scores/verdicts target responses) ---
JUDGE_URL=https://your-target/v1
JUDGE_API_KEY=
JUDGE_MODEL=openai/gpt-4o-mini

# --- Attacker model (TAP/PAIR/Crescendo/GOAT refinement) ---
ATTACKER_URL=https://your-target/v1
ATTACKER_API_KEY=
ATTACKER_MODEL=openai/gpt-4o-mini

# --- Generic any-llm-sdk provider fallback (create_completion_kwargs) ---
LLM_PROVIDER=openai
API_KEY=
BASE_URL=
